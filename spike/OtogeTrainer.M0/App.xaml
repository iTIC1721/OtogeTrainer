<Application x:Class="OtogeTrainer.M0.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- UI-BLUEPRINT §11 팔레트 -->
        <SolidColorBrush x:Key="Bg0"      Color="#0E0F12" />
        <SolidColorBrush x:Key="Bg1"      Color="#16181D" />
        <SolidColorBrush x:Key="Bg2"      Color="#1E2127" />
        <SolidColorBrush x:Key="Fg0"      Color="#E8EAF0" />
        <SolidColorBrush x:Key="Fg1"      Color="#9AA0AC" />
        <SolidColorBrush x:Key="Accent"   Color="#4DA3FF" />
        <SolidColorBrush x:Key="Warn"     Color="#FFB454" />
        <SolidColorBrush x:Key="Loop"     Color="#2ED3A0" />
        <SolidColorBrush x:Key="Danger"   Color="#FF5C5C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg0}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Malgun Gothic" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg0}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Malgun Gothic" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
            <Setter Property="Foreground" Value="{StaticResource Fg0}" />
            <Setter Property="BorderBrush" Value="#2A2E36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Malgun Gothic" />
        </Style>

    </Application.Resources>
</Application>
