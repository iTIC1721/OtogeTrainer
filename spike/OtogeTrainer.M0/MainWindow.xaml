<Window x:Class="OtogeTrainer.M0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OtogeTrainer — M0 스파이크 (입력 게이트 검증)"
        Height="820" Width="1180"
        Background="{StaticResource Bg0}"
        UseLayoutRounding="True">

    <Grid Margin="16" x:Name="PlayerRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- ── 헤더 / 토글 ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="M0-6  재생 중 단축키 차단 검증"
                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="  SPEC §6.2 누출 경로 자동 검출"
                       Foreground="{StaticResource Fg1}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Bg1}" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkGuard" IsChecked="True"
                          Content="입력 가드 사용 (끄면 누출이 재현됩니다)"
                          Checked="OnGuardToggled" Unchecked="OnGuardToggled" />
                <CheckBox x:Name="ChkAllowWhilePlaying"
                          Content="재생 중에도 단축키 허용 (FR-508)"
                          Checked="OnGuardToggled" Unchecked="OnGuardToggled" />
                <Button Content="누출 기록 초기화" Click="OnResetLeaks" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ── 가짜 영상 영역 ───────────────────────────────────────────── -->
        <Border Grid.Row="2" x:Name="VideoSurface" Background="#000000"
                BorderBrush="Transparent" BorderThickness="2" CornerRadius="4">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBadge" Text="⏸  일시정지 · 단축키 사용"
                               FontSize="22" HorizontalAlignment="Center"
                               Foreground="{StaticResource Fg0}" />
                    <TextBlock x:Name="TxtHint" Text="재생을 누르고 키보드를 마음껏 두드려 보세요"
                               Foreground="{StaticResource Fg1}" HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="TxtClock" Text="00:00:00.000   f#0"
                               FontFamily="Cascadia Mono, Consolas" FontSize="34"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="TxtIntegrity" Text=""
                               FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{StaticResource Fg1}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 컨트롤 바 (누출 함정) ────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource Bg1}" CornerRadius="6"
                Padding="12,10" Margin="0,12,0,12">
            <StackPanel>
                <Slider x:Name="SldTimeline" Minimum="0" Maximum="1000" Value="0"
                        ValueChanged="OnTimelineValueChanged" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnPlayPause" Content="▶  재생" Click="OnPlayPause" MinWidth="96" />
                    <Button Content="⏮ 5s"   Click="OnJumpBack" />
                    <Button Content="5s ⏭"   Click="OnJumpForward" />
                    <Button Content="◀❙ 1f"  Click="OnStepBack" />
                    <Button Content="1f ❙▶"  Click="OnStepForward" />
                    <Separator Width="12" Opacity="0" />
                    <Button Content="🔇 음소거"  Click="OnNoop" />
                    <Button Content="⛶ 전체화면" Click="OnNoop" />
                    <Button Content="📌 항상 위"  Click="OnNoop" />
                    <TextBlock Text="← D-4 예외 없음이므로 이 버튼들이 재생 중 유일한 경로"
                               Foreground="{StaticResource Fg1}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 로그 / 누출 리포트 ───────────────────────────────────────── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="키 이벤트 로그" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" Foreground="{StaticResource Fg1}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="6"
                    Padding="10" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SPEC §6.2 누출 경로 검사"
                               FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="TxtLeaks" FontFamily="Cascadia Mono, Consolas"
                               FontSize="12" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
