<UserControl x:Class="OtogeTrainer.App.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OtogeTrainer.App"
             xmlns:lib="clr-namespace:OtogeTrainer.App.Library">

    <UserControl.Resources>
        <app:HasValueToVisibilityConverter x:Key="HasValue" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBool" />
        <app:ProgressWidthConverter x:Key="ProgressWidth" />

        <!-- 영상 카드 (UI-BLUEPRINT §3) -->
        <DataTemplate x:Key="VideoCard" DataType="{x:Type lib:VideoCardItem}">
            <Button Margin="0,0,16,16" Padding="0" Width="256"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Bg1}"
                    Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="{Binding Path}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="태그 편집…"
                                  Command="{Binding EditTagsCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel x:Name="Card">
                    <!-- 썸네일 16:9 -->
                    <Grid Height="144" ClipToBounds="True">
                        <Border Background="{StaticResource Bg2}" CornerRadius="5,5,0,0">
                            <TextBlock Text="🎞" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Fg2}" />
                        </Border>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                Background="#CC0E0F12" CornerRadius="3" Padding="6,2"
                                Visibility="{Binding DurationText, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource MonoText}" FontSize="11" />
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                Background="#CCFF5C5C" CornerRadius="3" Padding="6,2"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="⚠ 파일 없음" FontSize="11" Foreground="#0E0F12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- 진행률 -->
                    <Grid x:Name="ProgressTrack" Height="3" Background="{StaticResource Bg3}">
                        <Border HorizontalAlignment="Left" Background="{StaticResource Accent}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                    <Binding Path="Progress" />
                                    <Binding Path="ActualWidth" ElementName="ProgressTrack" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>

                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding BookmarkText}" Style="{StaticResource Caption}" Margin="0,0,10,0"
                                       Foreground="{StaticResource Bookmark}"
                                       Visibility="{Binding BookmarkText, Converter={StaticResource HasValue}}" />
                            <TextBlock Text="{Binding OffsetText}" Style="{StaticResource Caption}" Margin="0,0,10,0"
                                       Foreground="{StaticResource Warn}"
                                       Visibility="{Binding OffsetText, Converter={StaticResource HasValue}}" />
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}"
                                       Visibility="{Binding SpeedText, Converter={StaticResource HasValue}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TagsText, Converter={StaticResource HasValue}}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8"
                    Content="📂  영상 열기  (Ctrl+O)"
                    Command="{Binding DataContext.OpenFileDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="⚙  설정" Margin="0,0,8,0"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="재생 중 동작 키 바꾸기" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                    Command="{Binding ManageFoldersCommand}"
                    ToolTip="녹화 영상이 저장되는 폴더를 등록하면 새 영상을 자동으로 올립니다">
                <TextBlock>
                    <Run Text="💾  녹화 폴더" />
                    <Run Text="{Binding FolderCount, Mode=OneWay}" Foreground="{StaticResource Fg1}" />
                </TextBlock>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OtogeTrainer" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="플레이 영상 복기" Style="{StaticResource Caption}" FontSize="13" Margin="12,6,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 검색 · 정렬 (FR-106) -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10"
                   Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Sorts}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type lib:SortOption}">
                        <Button x:Name="SortButton" Style="{StaticResource Chip}" Margin="6,0,0,0"
                                Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock x:Name="SortText" Text="{Binding Label}" />
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SortButton" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="SortText" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Width="340" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Padding="30,6,8,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Text="🔍" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource Fg2}" />
                <TextBlock Text="제목 · 태그 검색" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource Fg2}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- 태그 칩 (FR-107) · 목록 제목 -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type lib:TagChip}">
                        <Button x:Name="TagButton" Style="{StaticResource Chip}"
                                Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock x:Name="TagText" Text="{Binding Text}" />
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TagButton" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,8,0,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStatus}" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding ScanStatus}" />
                <TextBlock Text="{Binding ListHeader}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Content="✕ 검색 · 필터 해제" Margin="12,0,0,0" Padding="8,2"
                        MinHeight="24" FontSize="12" HorizontalAlignment="Left"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <ItemsControl ItemsSource="{Binding Videos}" ItemTemplate="{StaticResource VideoCard}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="조건에 맞는 영상이 없습니다." Style="{StaticResource Caption}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

        <!-- 첫 실행 빈 상태 -->
        <Border Grid.Row="1" Grid.RowSpan="3" Margin="0,0,0,32" CornerRadius="10"
                BorderBrush="{StaticResource Bg3}" BorderThickness="2"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎞" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource Fg2}" />
                <TextBlock Text="영상 파일을 여기로 끌어다 놓으세요" FontSize="18" Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="또는 우측 상단의 영상 열기 · 녹화 폴더를 등록하면 새 영상이 자동으로 올라옵니다"
                           Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Caption}" FontSize="12" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Warn}"
                           Visibility="{Binding ScanStatus, Converter={StaticResource HasValue}}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,8,0,12" Style="{StaticResource Caption}"
                   Text="카드를 누르면 마지막 위치 · 배속 · 오프셋 · 북마크가 복원된 상태로 열립니다. 우클릭 → 태그 편집." />
    </Grid>
</UserControl>
