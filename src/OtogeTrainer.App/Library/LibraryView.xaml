<UserControl x:Class="OtogeTrainer.App.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OtogeTrainer.App"
             xmlns:lib="clr-namespace:OtogeTrainer.App.Library">

    <UserControl.Resources>
        <app:HasValueToVisibilityConverter x:Key="HasValue" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBool" />
        <app:ProgressWidthConverter x:Key="ProgressWidth" />

        <!-- 최근 재생 카드 (UI-BLUEPRINT §3) -->
        <DataTemplate x:Key="RecentCard" DataType="{x:Type lib:RecentVideoItem}">
            <Button Margin="0,0,16,16" Padding="0" Width="256"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Bg1}"
                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Path}">
                <StackPanel x:Name="Card">
                    <!-- 썸네일 16:9 -->
                    <Grid Height="144" ClipToBounds="True">
                        <Border Background="{StaticResource Bg2}" CornerRadius="5,5,0,0">
                            <TextBlock Text="🎞" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Fg2}" />
                        </Border>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                Background="#CC0E0F12" CornerRadius="3" Padding="6,2"
                                Visibility="{Binding DurationText, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource MonoText}" FontSize="11" />
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                Background="#CCFF5C5C" CornerRadius="3" Padding="6,2"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="⚠ 파일 없음" FontSize="11" Foreground="#0E0F12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- 진행률 -->
                    <Grid x:Name="ProgressTrack" Height="3" Background="{StaticResource Bg3}">
                        <Border HorizontalAlignment="Left" Background="{StaticResource Accent}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                    <Binding Path="Progress" />
                                    <Binding Path="ActualWidth" ElementName="ProgressTrack" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>

                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding BookmarkText}" Style="{StaticResource Caption}" Margin="0,0,10,0"
                                       Foreground="{StaticResource Bookmark}" />
                            <TextBlock Text="{Binding OffsetText}" Style="{StaticResource Caption}" Margin="0,0,10,0"
                                       Foreground="{StaticResource Warn}" />
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8"
                    Content="📂  영상 열기  (Ctrl+O)"
                    Command="{Binding DataContext.OpenFileDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="⚙  설정" Margin="0,0,8,0"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="재생 중 동작 키 바꾸기" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OtogeTrainer" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="플레이 영상 복기" Style="{StaticResource Caption}" FontSize="13" Margin="12,6,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="최근 재생" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"
                   Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource RecentCard}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- 첫 실행 빈 상태 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,32" CornerRadius="10"
                BorderBrush="{StaticResource Bg3}" BorderThickness="2"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎞" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource Fg2}" />
                <TextBlock Text="영상 파일을 여기로 끌어다 놓으세요" FontSize="18" Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="또는 우측 상단의 영상 열기 · mp4 mkv mov avi webm ts m2ts flv wmv"
                           Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,12" Style="{StaticResource Caption}"
                   Text="카드를 누르면 마지막 위치 · 배속 · 오프셋 · 북마크가 복원된 상태로 열립니다." />
    </Grid>
</UserControl>
