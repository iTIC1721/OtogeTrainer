<Window x:Class="OtogeTrainer.App.Library.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg0}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="Message" Margin="0,8,0,0" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" />

        <TextBox x:Name="NameBox" Margin="0,14,0,0" MaxLength="40" TextChanged="OnTextChanged" />
        <TextBlock x:Name="Error" Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <DockPanel Margin="0,18,0,0">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="확인" MinWidth="88"
                    IsDefault="True" Click="OnOk" />
            <Button DockPanel.Dock="Right" Content="취소" MinWidth="88" Margin="0,0,8,0" IsCancel="True" />
            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="Enter 확인 · Esc 취소" />
        </DockPanel>
    </StackPanel>
</Window>
