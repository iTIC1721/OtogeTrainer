<Window x:Class="OtogeTrainer.App.Library.DirectoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:OtogeTrainer.App.Library"
        Width="460" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Bg0}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="Message" Margin="0,8,0,12" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="여기로" MinWidth="88"
                    IsDefault="True" Click="OnOk" />
            <Button DockPanel.Dock="Right" Content="취소" MinWidth="88" Margin="0,0,8,0" IsCancel="True" />
            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="두 번 눌러도 선택됩니다" />
        </DockPanel>

        <Border Background="{StaticResource Bg1}" CornerRadius="6" Padding="6">
            <ListBox x:Name="Choices" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg2}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#334DA3FF" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type lib:DirectoryChoice}">
                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" FontSize="14" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
